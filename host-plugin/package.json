{
  "name": "dsh-plugin-nova-buddy",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "description": "Nova Buddy 的 DSH 宿主侧桥接：把会话状态、订阅额度、ModelDial 榜单与工具审批推送到 ESP32-S3 AMOLED 副屏（MQTT）。",
  "bin": {
    "nova-buddy": "./bin/nova-buddy.js"
  },
  "exports": {
    ".": "./index.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "lib",
    "bin",
    "cordis.patch.yml",
    "locale/en.json",
    "locale/zh.json",
    "icon.svg",
    "README.md"
  ],
  "dependencies": {
    "mqtt": "^5.10.4"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "mqtt",
    "esp32",
    "amoled",
    "desktop-companion"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JAYcodr/whale-buddy-esp32.git"
  }
}
