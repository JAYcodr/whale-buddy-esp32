{
  "name": "dsh-plugin-nova-buddy",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "description": "Nova Buddy desktop companion bridge: MQTT state, quota cards, ModelDial radar, and remote tool approval for ESP32-S3 AMOLED.",
  "bin": {
